// GB 15603-2022《危险化学品仓库储存通则》精选条文语料（现行版，2022-12-29 发布 / 2023-07-01 实施）
// 来源：中国建筑科学研究院建筑防火研究所·消防规范网 规范全文库（采集日期 2026-09-10）
//   - https://gf.cabr-fire.com/article-65543.htm（1 范围）
//   - https://gf.cabr-fire.com/article-65545.htm（3 术语和定义）
//   - https://gf.cabr-fire.com/article-65546.htm（4 基本要求）
//   - https://gf.cabr-fire.com/article-65547.htm（5 储存要求）
//   - https://gf.cabr-fire.com/article-65548.htm（6 装卸搬运与堆码）
//   - https://gf.cabr-fire.com/article-65549.htm（7 入库作业）
//   - https://gf.cabr-fire.com/article-65550.htm（8 在库管理）
//   - https://gf.cabr-fire.com/article-65551.htm（9 出库作业）
//   - https://gf.cabr-fire.com/article-65553.htm（11 安全管理）
// 另经天津师范大学国有资产管理处转载的标准正式版 PDF 交叉核对：
//   - https://gyzc.tjnu.edu.cn/info/1103/1591.htm
// 格式：[{law,no,title,text}]，按"仓库储存/双人双锁/禁配相关"口径精选 26 条。
[
 {
  "law": "GB15603",
  "no": "3.2",
  "title": "3 术语和定义",
  "text": "禁忌物品 incompatible materials\n容易相互发生化学反应或灭火方法不同的物品。"
 },
 {
  "law": "GB15603",
  "no": "3.3",
  "title": "3 术语和定义",
  "text": "隔离储存 segregated storage\n在同一房间或同一区域内，不同的物品之间分开一定的距离，非禁忌物品间用通道保持空间的储存方式。"
 },
 {
  "law": "GB15603",
  "no": "3.4",
  "title": "3 术语和定义",
  "text": "隔开储存 cut-off storage\n在同一建筑或同一区域内，用隔板或墙，将不同禁忌物品分离开的储存方式。"
 },
 {
  "law": "GB15603",
  "no": "3.5",
  "title": "3 术语和定义",
  "text": "分离储存 detached storage\n在不同的建筑物或同一建筑不同房间的储存方式。"
 },
 {
  "law": "GB15603",
  "no": "4.1",
  "title": "4 基本要求",
  "text": "危险化学品储存、经营企业的仓库规划选址、建设、安全设施，应符合GB 50016、GB18265的要求。"
 },
 {
  "law": "GB15603",
  "no": "4.2",
  "title": "4 基本要求",
  "text": "应建立危险化学品储存信息管理系统，按照储存量大小进行分层次要求，实时记录作业基础数据，包括但不限于：\na）危险化学品出入库记录，包括但不限于：时间、品种、品名、数量；\nb）识别化学品安全技术说明书中要求的灭火介质、应急、消防要求以及危险特性，理化性质，搬运、储存注意事项和禁忌等，以及可能涉及安全相容矩阵表；\nc）库存危险化学品品种、数量、库内分布、包装形式等信息；\nd）库存危险化学品禁忌配存情况；\ne）库存危险化学品安全和应急措施。"
 },
 {
  "law": "GB15603",
  "no": "4.3",
  "title": "4 基本要求",
  "text": "危险化学品储存信息数据应进行异地实时备份，数据保存期限不少于1年。"
 },
 {
  "law": "GB15603",
  "no": "5.1",
  "title": "5 储存要求",
  "text": "危险化学品仓库应采用隔离储存、隔开储存、分离储存的方式对危险化学品进行储存。"
 },
 {
  "law": "GB15603",
  "no": "5.2",
  "title": "5 储存要求",
  "text": "应选择符合危险化学品的特性、防火要求及化学品安全技术说明书中储存要求的仓储设施进行储存。"
 },
 {
  "law": "GB15603",
  "no": "5.5",
  "title": "5 储存要求",
  "text": "危险化学品的储存配存，应符合附录A及其化学品安全技术说明书的要求。"
 },
 {
  "law": "GB15603",
  "no": "5.9",
  "title": "5 储存要求",
  "text": "剧毒化学品、易燃气体、氧化性气体、急性毒性气体、遇水放出易燃气体的物质和混合物、氯酸盐、高锰酸盐、亚硝酸盐、过氧化钠、过氧化氢、溴素应分离储存。"
 },
 {
  "law": "GB15603",
  "no": "5.10",
  "title": "5 储存要求",
  "text": "剧毒化学品、监控化学品、易制毒化学品、易制爆危险化学品，应按规定将储存地点、储存数量、流向及管理人员的情况报相关部门备案，剧毒化学品以及构成重大危险源的危险化学品，应在专用仓库内单独存放，并实行双人收发、双人保管制度。"
 },
 {
  "law": "GB15603",
  "no": "6.1.1",
  "title": "6 装卸搬运与堆码",
  "text": "应按照化学品安全技术说明书及装卸要求进行作业。"
 },
 {
  "law": "GB15603",
  "no": "6.1.2",
  "title": "6 装卸搬运与堆码",
  "text": "应做到轻拿轻放，不应拖拉、翻滚、撞击、摩擦、摔扔、挤压等。"
 },
 {
  "law": "GB15603",
  "no": "6.1.3",
  "title": "6 装卸搬运与堆码",
  "text": "应使用防爆叉车搬运装卸爆炸物及其他易发生燃烧爆炸的危险化学品。"
 },
 {
  "law": "GB15603",
  "no": "6.2.1",
  "title": "6 装卸搬运与堆码",
  "text": "危险化学品堆码应整齐、牢固、无倒置；不应遮挡消防设备、安全设施、安全标志和通道。"
 },
 {
  "law": "GB15603",
  "no": "6.2.5",
  "title": "6 装卸搬运与堆码",
  "text": "仓库堆垛间距应满足以下要求：\na）主通道大于或等于200cm；\nb）墙距大于或等于50cm；\nc）柱距大于或等于30cm；\nd）垛距大于或等于100cm（每个堆垛的面积不应大于150㎡）；\ne）灯距大于或等于50cm。"
 },
 {
  "law": "GB15603",
  "no": "7.3",
  "title": "7 入库作业",
  "text": "应对入库危险化学品的品名、规格、数量与入库信息或单据的一致性进行查验。"
 },
 {
  "law": "GB15603",
  "no": "7.4",
  "title": "7 入库作业",
  "text": "入库物品的包装应完好，标志、安全标签应规范、清晰。"
 },
 {
  "law": "GB15603",
  "no": "7.6",
  "title": "7 入库作业",
  "text": "入库数量应以实际验收为准。"
 },
 {
  "law": "GB15603",
  "no": "7.7",
  "title": "7 入库作业",
  "text": "验收完毕应作好记录并归档，单据保存期限不少于1年。"
 },
 {
  "law": "GB15603",
  "no": "8.1",
  "title": "8 在库管理",
  "text": "应定期进行盘点，并记录。发现账货不符，应及时进行处理。"
 },
 {
  "law": "GB15603",
  "no": "8.3",
  "title": "8 在库管理",
  "text": "应根据储存的危险化学品特性和气候条件，确定每日观测库内温湿度次数，并记录。"
 },
 {
  "law": "GB15603",
  "no": "9.1",
  "title": "9 出库作业",
  "text": "应在出库作业前，进行账货核对。"
 },
 {
  "law": "GB15603",
  "no": "11.2.2",
  "title": "11 安全管理",
  "text": "库区内严禁吸烟和使用明火。"
 },
 {
  "law": "GB15603",
  "no": "11.3.3",
  "title": "11 安全管理",
  "text": "储存仓库内禁止进行开桶、分装、改装作业。"
 }
]